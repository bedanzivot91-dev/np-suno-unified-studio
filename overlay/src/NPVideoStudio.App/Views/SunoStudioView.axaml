<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NPVideoStudio.App.ViewModels"
             x:Class="NPVideoStudio.App.Views.SunoStudioView"
             x:DataType="vm:SunoStudioViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="surface" Padding="14,10" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Content="Pokušaj ponovo" Command="{Binding RetryCommand}"
                IsVisible="{Binding !IsReady}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="760"
                Spacing="16">
      <TextBlock Text="SUNO PESME STUDIO"
                 FontSize="28"
                 FontWeight="Bold"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Kompletan Suno Studio radi iz istog NP + Suno Unified Studio programa. Otvara se u zasebnom prozoru iste aplikacije da video editor ne bi kočio zbog ugrađenog Windows WebView kontrolera."
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Opacity="0.8" />
      <Button Content="OTVORI SUNO STUDIO"
              HorizontalAlignment="Center"
              Padding="24,12"
              IsEnabled="{Binding IsReady}"
              Click="OpenSunoStudio_Click" />
      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
